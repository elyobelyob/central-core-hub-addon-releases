FROM python:3.14-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the code
COPY central-core-hub/ ./central-core-hub/

# Run tests
CMD ["pytest", "central-core-hub/tests/", "--cov=central-core-hub", "--cov-report=term-missing"]